{
  "project": "Maritime Survival & Demographic Hazard Model",
  "dataset": "RMS Titanic Passenger Manifest Cohort (N=891, d=8)",
  "validation_scheme": "5-Fold Stratified Cross-Validation",
  "features": [
    "Pclass_Cabin_Tier",
    "Sex_Female_Indicator",
    "Age_Years",
    "SibSp_Count",
    "Parch_Count",
    "Ticket_Fare_GBP",
    "Embarkation_Port",
    "Is_Traveling_Alone"
  ],
  "results": [
    {
      "model": "Logistic Regression (L2)",
      "accuracy": 0.8283,
      "precision": 0.7438,
      "recall": 0.5152,
      "f1": 0.6087,
      "roc_auc": 0.8589,
      "brier_score": 0.1218
    },
    {
      "model": "Random Forest (200 Trees)",
      "accuracy": 0.8373,
      "precision": 0.7945,
      "recall": 0.5022,
      "f1": 0.6154,
      "roc_auc": 0.8556,
      "brier_score": 0.1231
    },
    {
      "model": "HistGradientBoosting",
      "accuracy": 0.8339,
      "precision": 0.7318,
      "recall": 0.5671,
      "f1": 0.639,
      "roc_auc": 0.8474,
      "brier_score": 0.1263
    }
  ]
}